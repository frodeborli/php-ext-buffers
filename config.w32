ARG_ENABLE("buffers", "buffers support", "no");

if (PHP_BUFFERS != "no") {
	EXTENSION("buffers", "buffers.c dtype.c device.c shape.c buffer.c props.c view.c capsule.c transfer.c convert.c api.c dataview.c");
	AC_DEFINE("HAVE_BUFFERS", 1, "buffers support enabled");
	PHP_INSTALL_HEADERS("ext/buffers", "php_buffers_api.h dlpack.h");
}
